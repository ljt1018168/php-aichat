<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AI 数据助手</title>
    <style>
        body { background: #f5f7fa; margin: 0; font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif; }
        .ai-wrap { display: flex; flex-direction: column; height: 100vh; max-width: 900px; margin: 0 auto; background: #fff; }
        .ai-header {
            padding: 14px 20px; border-bottom: 1px solid #eee; display: flex;
            align-items: center; justify-content: space-between; background: #fff;
        }
        .ai-header h3 { margin: 0; font-size: 16px; font-weight: 600; color: #333; }
        .ai-header .ai-sub { font-size: 12px; color: #999; margin-top: 2px; }
        .ai-clear-btn {
            background: none; border: 1px solid #d6ebfa; color: #42a5f5; border-radius: 4px;
            padding: 4px 12px; font-size: 12px; cursor: pointer;
        }
        .ai-clear-btn:hover { background: #eaf4fd; }
        .ai-body { flex: 1; overflow-y: auto; padding: 20px; background: #fafbfc; }
        .ai-msg { display: flex; margin-bottom: 18px; }
        .ai-msg.me { flex-direction: row-reverse; }
        .ai-avatar {
            width: 32px; height: 32px; border-radius: 50%; flex: 0 0 32px;
            background: #42a5f5; color: #fff; text-align: center; line-height: 32px;
            font-size: 12px; margin: 0 10px;
        }
        .ai-msg.me .ai-avatar { background: #78909c; }
        .ai-bubble {
            max-width: 72%; padding: 10px 14px; border-radius: 8px; font-size: 14px;
            line-height: 1.7; word-break: break-all; background: #fff;
            border: 1px solid #e8eaed; color: #333;
        }
        .ai-msg.me .ai-bubble { background: #42a5f5; color: #fff; border-color: #42a5f5; }
        .ai-bubble table { border-collapse: collapse; margin: 8px 0; font-size: 13px; width: 100%; }
        .ai-bubble table th, .ai-bubble table td { border: 1px solid #e0e0e0; padding: 6px 10px; text-align: left; }
        .ai-bubble table th { background: #f5f7fa; font-weight: 600; }
        .ai-bubble p { margin: 4px 0; }
        .ai-tips { color: #999; font-size: 12px; padding: 6px 0; }
        .ai-footer { border-top: 1px solid #eee; padding: 12px 20px; background: #fff; }
        .ai-input-row { display: flex; gap: 10px; align-items: flex-end; }
        .ai-input-row textarea {
            flex: 1; height: 60px; resize: none; border: 1px solid #dcdfe6;
            border-radius: 6px; padding: 8px 12px; font-size: 14px; line-height: 1.5;
            font-family: inherit; box-sizing: border-box;
        }
        .ai-input-row textarea:focus { outline: none; border-color: #42a5f5; }
        .ai-send {
            background: #42a5f5; color: #fff; border: none; border-radius: 6px;
            padding: 0 22px; height: 60px; cursor: pointer; font-size: 14px;
        }
        .ai-send:hover { background: #3793e0; }
        .ai-send:disabled { background: #b0bec5; cursor: not-allowed; }
        .ai-quick { padding: 0 0 10px 0; }
        .ai-quick span {
            display: inline-block; margin: 0 8px 6px 0; padding: 4px 12px; font-size: 12px;
            color: #42a5f5; background: #eaf4fd; border-radius: 12px; cursor: pointer;
        }
        .ai-quick span:hover { background: #d6ebfa; }
        .ai-disabled { padding: 40px; text-align: center; color: #999; }
        .ai-loading { color: #999; font-size: 13px; padding: 4px 0; }
        .ai-err { color: #e57373; }
    </style>
</head>
<body>
<div class="ai-wrap">
    <div class="ai-header">
        <div>
            <h3>AI 数据助手</h3>
            <div class="ai-sub">用自然语言查询业务数据</div>
        </div>
        <button class="ai-clear-btn" id="btn-clear">清空会话</button>
    </div>

    <div class="ai-body" id="ai-body">
        <div class="ai-tips">直接输入你的问题，AI 会调用你有权限的数据查询工具并整理结果。</div>
    </div>

    <div class="ai-footer">
        <div class="ai-quick" id="ai-quick">
            <span data-q="你能查询哪些数据？">使用帮助</span>
        </div>
        <div class="ai-input-row">
            <textarea id="ai-input" placeholder="输入你的问题，回车发送（Shift+回车换行）"></textarea>
            <button class="ai-send" id="ai-send">发送</button>
        </div>
    </div>
</div>

<script>
    // 后端注入：开关与接口前缀（原生 PHP 模板，框架无关）
    var ENABLED = <?= !empty($enable) ? 'true' : 'false' ?>;
    var API_BASE = <?= json_encode((string)($api_base ?? '/aichat'), JSON_UNESCAPED_SLASHES) ?>;
    var conversationId = 0;
    var sending = false;

    var body = document.getElementById('ai-body');
    var input = document.getElementById('ai-input');
    var sendBtn = document.getElementById('ai-send');

    if (!ENABLED) {
        body.innerHTML = '<div class="ai-disabled">AI 对话功能未开启，请联系管理员在 .env 中配置 [AICHAT] 项。</div>';
        sendBtn.disabled = true;
    }

    // 快捷问题
    document.getElementById('ai-quick').addEventListener('click', function (e) {
        if (e.target.tagName === 'SPAN') {
            input.value = e.target.getAttribute('data-q');
            send();
        }
    });

    sendBtn.addEventListener('click', send);

    input.addEventListener('keydown', function (e) {
        if (e.keyCode === 13 && !e.shiftKey) {
            e.preventDefault();
            send();
        }
    });

    document.getElementById('btn-clear').addEventListener('click', function () {
        if (!conversationId) { return; }
        fetch(API_BASE + '/clear', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'conversation_id=' + conversationId
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res.code === 0) {
                conversationId = 0;
                body.innerHTML = '<div class="ai-tips">已清空会话，可重新提问。</div>';
            }
        })
        .catch(function () {});
    });

    function send() {
        var q = (input.value || '').trim();
        if (!q || sending) { return; }

        appendMsg('me', escapeHtml(q));
        input.value = '';
        sending = true;
        sendBtn.disabled = true;

        var loadId = appendLoading();

        fetch(API_BASE + '/chat', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question: q, conversation_id: conversationId })
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            removeEl(loadId);
            if (res.code === 0) {
                conversationId = (res.data && res.data.conversation_id) || conversationId;
                appendMsg('ai', renderMarkdown((res.data && res.data.answer) || ''));
            } else if (res.code === 401) {
                appendMsg('ai', '<span class="ai-err">登录已失效，请重新登录。</span>');
            } else {
                appendMsg('ai', '<span class="ai-err">' + escapeHtml(res.msg || '查询失败') + '</span>');
            }
        })
        .catch(function () {
            removeEl(loadId);
            appendMsg('ai', '<span class="ai-err">请求失败，请稍后重试。</span>');
        })
        .then(function () {
            sending = false;
            sendBtn.disabled = false;
            scrollBottom();
        });
    }

    function appendMsg(who, html) {
        var avatar = who === 'me' ? '我' : 'AI';
        var cls = who === 'me' ? 'ai-msg me' : 'ai-msg';
        var div = document.createElement('div');
        div.className = cls;
        div.innerHTML =
            '<div class="ai-avatar">' + avatar + '</div>' +
            '<div class="ai-bubble">' + html + '</div>';
        body.appendChild(div);
        scrollBottom();
    }

    function appendLoading() {
        var id = 'loading-' + Date.now();
        var div = document.createElement('div');
        div.className = 'ai-msg';
        div.id = id;
        div.innerHTML =
            '<div class="ai-avatar">AI</div>' +
            '<div class="ai-bubble ai-loading">正在查询，请稍候…</div>';
        body.appendChild(div);
        scrollBottom();
        return id;
    }

    function removeEl(id) {
        var n = document.getElementById(id);
        if (n && n.parentNode) { n.parentNode.removeChild(n); }
    }

    function scrollBottom() {
        body.scrollTop = body.scrollHeight;
    }

    function escapeHtml(s) {
        if (s === null || s === undefined) { return ''; }
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    /**
     * 极简 Markdown 渲染：表格 + 段落 + 简单列表（与 ai-float.js 逻辑一致，保证两端结果统一）
     * 不引入第三方库，所有内容先转义再拼装，防 XSS
     */
    function renderMarkdown(text) {
        if (!text) { return ''; }
        var lines = String(text).split('\n');
        var html = '';
        var tableBuf = [];
        var inTable = false;

        function flushTable() {
            if (!tableBuf.length) { return; }
            var h = '<table>';
            for (var i = 0; i < tableBuf.length; i++) {
                var cells = tableBuf[i].split('|');
                cells = cells.filter(function (c, idx) {
                    return !(idx === 0 && c.trim() === '') &&
                           !(idx === cells.length - 1 && c.trim() === '');
                });
                // 跳过分隔行 |---|---|
                if (cells.length && cells[0].trim().indexOf('---') === 0) { continue; }
                var isHead = (i === 0);
                h += '<tr>';
                for (var j = 0; j < cells.length; j++) {
                    h += isHead ? '<th>' : '<td>';
                    h += escapeHtml(cells[j].trim());
                    h += isHead ? '</th>' : '</td>';
                }
                h += '</tr>';
            }
            h += '</table>';
            html += h;
            tableBuf = [];
            inTable = false;
        }

        for (var k = 0; k < lines.length; k++) {
            var line = lines[k];
            if (line.indexOf('|') === 0 || (line.indexOf('|') > -1 && /^\s*\|?[\s\S]*\|\s*$/.test(line))) {
                tableBuf.push(line);
                inTable = true;
                continue;
            }
            if (inTable) { flushTable(); }
            if (/^\s*[-*]\s+/.test(line)) {
                html += '<p>• ' + escapeHtml(line.replace(/^\s*[-*]\s+/, '')) + '</p>';
                continue;
            }
            if (String(line).trim() === '') { continue; }
            html += '<p>' + escapeHtml(line) + '</p>';
        }
        if (inTable) { flushTable(); }

        return html || escapeHtml(text);
    }
</script>
</body>
</html>